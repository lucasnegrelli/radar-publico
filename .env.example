# Copie este arquivo para ".env" (na mesma pasta) e preencha. O ".env" NÃO vai para o GitHub (está no .gitignore).
# e-Agendas (CGU): agenda oficial de ministros e autoridades do Executivo federal.
# Gere o token em https://eagendas.cgu.gov.br/ (entrar com gov.br > seu perfil > "Meus tokens"). Ele só aparece uma vez.
EAGENDAS_TOKEN=

# Portal da Transparência (CGU): API de dados. Cadastre o e-mail em https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TOKEN=
